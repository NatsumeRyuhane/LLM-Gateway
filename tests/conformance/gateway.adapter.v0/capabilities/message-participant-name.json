{
  "contract_version": "gateway.adapter.v0",
  "capability": "message.participant_name",
  "cases": [
    {
      "name": "supported-preserves-participant-name",
      "route_state": "supported",
      "canonical_request": {
        "messages": [
          { "role": "user", "name": "caller", "content": ["hello"] }
        ]
      },
      "expected": {
        "eligible": true,
        "preserved": { "messages[0].name": "caller" }
      }
    },
    {
      "name": "unsupported-rejects-before-dispatch",
      "route_state": "unsupported",
      "required_value": "caller",
      "expected": {
        "eligible": false,
        "dispatched": false,
        "failure": {
          "code": "capability.unsupported",
          "domain": "capability",
          "retry_disposition": "never"
        }
      }
    },
    {
      "name": "unverified-rejects-before-dispatch",
      "route_state": "unverified",
      "required_value": "caller",
      "expected": {
        "eligible": false,
        "dispatched": false,
        "failure": {
          "code": "capability.unsupported",
          "domain": "capability",
          "retry_disposition": "never"
        }
      }
    }
  ]
}
